# The existing .env.local contains the API key. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
# Local rehearsal defaults to a deterministic rubric simulator. Set true only to test the live API judge locally.
AIDA_AI_JUDGE_LIVE=false
AIDA_PUBLIC_URL=https://aidarescue.com
# Local review only. Never enable on a public deployment.
AIDA_LOCAL_DEMO=true
# Production: set all three. Do not prefix secret keys with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AIDA_TEAM_EMAIL_DOMAIN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Immutable prebuilt sandbox snapshot with Python packages installed.
AIDA_SANDBOX_SNAPSHOT=
